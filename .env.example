HF_API_BASE_URL=
# Optional: Higgsfield key as id:secret, used when the browser has none saved.
HF_API_KEY=
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# Optional: save finished runs into this folder, e.g. a Google Drive for Desktop folder.
ARCHIVE_DIR=

# Optional: write a CSV log of every generation into this folder.
USAGE_LOG_DIR=

# Optional: central log sheet (scripts/usage-log-sheet.gs). Both must be set.
LOG_WEBHOOK_URL=
LOG_WEBHOOK_TOKEN=
